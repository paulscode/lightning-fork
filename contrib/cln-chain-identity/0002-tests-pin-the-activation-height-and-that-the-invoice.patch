From fbaed38a03e9d8f8314ff8979c9ef4d5c5efe0f3 Mon Sep 17 00:00:00 2001
From: Paul Lamb <paul@paulscode.com>
Date: Sat, 19 Sep 2026 22:15:37 -0500
Subject: [PATCH 2/4] tests: pin the activation height, and that the invoice
 prefix is unchanged

The activation height is what the gossip rule compares against, and it lives in
a table of per-network initialisers where a mistake is easy to make and
invisible until a channel announcement is wrongly refused or wrongly kept. Zero
is what turns the rule off, so a stray non-zero value on a chain that never
changed its proof of work would refuse every announcement it ever saw. Every
network the build knows is walked, not just the ones named here, so that one
added later is covered without anyone remembering to come back.

Also pins the BOLT 11 prefix of every network to exactly what upstream gives
it. That is not a change, it is a guard against one: an earlier version of this
series gave the chain its own prefix, and that was withdrawn in favour of
separating invoices with option_blake2b, an even bit in the `9` field that a
reader must refuse if it does not know it. Asserting the upstream values keeps
a future change deliberate rather than incidental.
---
 bitcoin/test/run-chainparams-blake2b.c | 91 ++++++++++++++++++++++++++
 1 file changed, 91 insertions(+)
 create mode 100644 bitcoin/test/run-chainparams-blake2b.c

diff --git a/bitcoin/test/run-chainparams-blake2b.c b/bitcoin/test/run-chainparams-blake2b.c
new file mode 100644
index 000000000..b6f4dbb2a
--- /dev/null
+++ b/bitcoin/test/run-chainparams-blake2b.c
@@ -0,0 +1,91 @@
+#include "config.h"
+#include <assert.h>
+#include <bitcoin/chainparams.h>
+#include <ccan/array_size/array_size.h>
+#include <common/setup.h>
+#include <common/utils.h>
+#include <string.h>
+
+/* AUTOGENERATED MOCKS START */
+/* AUTOGENERATED MOCKS END */
+
+/* The identity constants of doc/blake2b-chain-identity.md.
+ *
+ * Two things are deliberately absent here, and their absence is the point.
+ *
+ * chain_hash is the genesis hash both chains share, because a change of proof
+ * of work is not a change of chain, so there is nothing to pin.
+ *
+ * The BOLT 11 prefix is unchanged too. An invoice on this chain carries the
+ * same prefix it always did. What is to separate it from an invoice on the
+ * earlier rules is option_blake2b as an even bit in the `9` field, which no
+ * implementation sets yet, so today nothing does. The prefixes below are
+ * asserted to be exactly what upstream gives them, so that a future change has
+ * to be deliberate rather than incidental.
+ */
+static const struct {
+	const char *network;
+	const char *lightning_hrp;
+	u32 activation_height;
+} expected[] = {
+	{"bitcoin", "bc", 961640},
+	{"regtest", "bcrt", 0},
+	{"signet", "tbs", 0},
+	{"testnet4", "tb", 0},
+	{"testnet", "tb", 0},
+	{"liquid-regtest", "ert", 0},
+	{"liquid", "ex", 0},
+};
+
+int main(int argc, char *argv[])
+{
+	common_setup(argv[0]);
+
+	for (size_t i = 0; i < ARRAY_SIZE(expected); i++) {
+		const struct chainparams *p
+			= chainparams_for_network(expected[i].network);
+		assert(p);
+
+		/* Unchanged from upstream: the separation in BOLT 11 is the
+		 * feature bit, not the prefix. */
+		assert(streq(p->lightning_hrp, expected[i].lightning_hrp));
+
+		assert(p->blake2b_activation_height
+		       == expected[i].activation_height);
+	}
+
+	/* The activation height is what the gossip rule compares against, so
+	 * it must be set on the chain that changed its proof of work and left
+	 * alone everywhere else. Zero is what turns the rule off, and a stray
+	 * non-zero value on a chain that never moved would refuse every
+	 * channel announcement it ever saw. */
+	assert(chainparams_for_network("bitcoin")->blake2b_activation_height
+	       == 961640);
+	assert(chainparams_for_network("regtest")->blake2b_activation_height
+	       == 0);
+
+	/* The table above must cover every network this build defines, so that
+	 * one added later cannot quietly default to a height nobody checked.
+	 * Counting the separators avoids needing a mutable copy: these test
+	 * binaries link against chainparams.o and libcommon.a only. */
+	{
+		const char *all = chainparams_get_network_names(tmpctx);
+		size_t count = 1;
+
+		assert(all && *all);
+
+		for (const char *p = all; *p; p++) {
+			if (*p == ',')
+				count++;
+		}
+
+		/* If this fires, a network was added: put it in the table
+		 * above with the height it should carry, which is zero unless
+		 * it is a chain that changed its proof of work. */
+		assert(count == ARRAY_SIZE(expected));
+	}
+
+	common_shutdown();
+
+	return 0;
+}
-- 
