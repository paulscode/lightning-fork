 tests/test_bookkeeper.py                      | 10 +++++-----
 tests/test_invoices.py                        |  4 ++--
 tests/test_xpay.py                            |  4 ++--
 tests/utils.py                                |  4 ++--
 5 files changed, 16 insertions(+), 11 deletions(-)

