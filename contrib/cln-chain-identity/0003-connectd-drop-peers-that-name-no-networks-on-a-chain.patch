index 81a03d412..a87631e65 100644
--- a/lightningd/lightningd.h
+++ b/lightningd/lightningd.h
@@ -60,6 +60,9 @@ struct config {
 	/* Are we allowed to use DNS lookup for peers. */
 	bool use_dns;
 
+	/* Keep peers whose init names no networks (see connectd). */
+	bool allow_peers_without_networks;
+
 	/* Excplicitly turns 'on' or 'off' IP discovery feature. */
