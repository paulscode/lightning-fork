diff --git a/connectd/connectd.h b/connectd/connectd.h
index 11665cc24..a2e34411d 100644
--- a/connectd/connectd.h
+++ b/connectd/connectd.h
@@ -320,6 +320,12 @@ struct daemon {
 	/* Allow localhost to be considered "public", only with --developer */
 	bool dev_allow_localhost;
 
+	/* Keep a peer whose init names no networks at all.  Off by default
+	 * on a chain that shares its genesis with another: such a peer is
+	 * almost certainly a node of the other chain (LND never sent the
+	 * field), and nothing else identifies it before open_channel. */
+	bool allow_peers_without_networks;
+
 	/* How much to gossip allow a peer every second (bytes) */
 	size_t gossip_stream_limit;
 
