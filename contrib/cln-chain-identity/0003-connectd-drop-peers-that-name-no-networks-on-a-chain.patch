From 8155419a4a1af695d30166752da00fcd8d6a479f Mon Sep 17 00:00:00 2001
From: Paul Lamb <paul@paulscode.com>
Date: Mon, 14 Sep 2026 12:11:03 -0500
Subject: [PATCH 3/5] connectd: drop peers that name no networks on a chain
 that shares its genesis

A peer whose init names a network we do not share is dropped already.
A peer that names none is kept, which is right on Bitcoin, where such a
peer can only be a Bitcoin node, and wrong here: LND never sent the
networks field, so a silent peer is almost certainly a Bitcoin LND node
that shares our genesis, and nothing before open_channel tells it
apart. Its gossip queries and ours would cross until then.

On a chain whose chain_hash is not its genesis, a peer that names no
networks is now dropped with a warning that says so. On Bitcoin nothing
changes. --allow-peers-without-networks keeps such peers, for testing
against an implementation that does not send the field.
---
 connectd/connectd.c               |  1 +
 connectd/connectd.h               |  6 ++++++
 connectd/connectd_wire.csv        |  1 +
 connectd/peer_exchange_initmsg.c  | 15 +++++++++++++++
 contrib/msggen/msggen/schema.json | 26 ++++++++++++++++++++++++++
 doc/lightningd-config.5.md        |  8 ++++++++
 doc/schemas/listconfigs.json      | 26 ++++++++++++++++++++++++++
 lightningd/connect_control.c      |  1 +
 lightningd/lightningd.h           |  3 +++
 lightningd/options.c              |  5 +++++
 10 files changed, 92 insertions(+)

diff --git a/connectd/connectd.c b/connectd/connectd.c
index 54ac08918..64bb032bf 100644
--- a/connectd/connectd.c
+++ b/connectd/connectd.c
@@ -1684,6 +1684,7 @@ static void connect_init(struct daemon *daemon, const u8 *msg)
 				    &daemon->always_use_proxy,
 				    &daemon->dev_allow_localhost,
 				    &daemon->use_dns,
+				    &daemon->allow_peers_without_networks,
 				    &tor_password,
 				    &daemon->timeout_secs,
 				    &daemon->websocket_helper,
diff --git a/connectd/connectd.h b/connectd/connectd.h
index 11665cc24..a2e34411d 100644
--- a/connectd/connectd.h
+++ b/connectd/connectd.h
@@ -320,6 +320,12 @@ struct daemon {
 	/* Allow localhost to be considered "public", only with --developer */
 	bool dev_allow_localhost;
 
+	/* Keep a peer whose init names no networks at all.  Off by default
+	 * on a chain that shares its genesis with another: such a peer is
+	 * almost certainly a node of the other chain (LND never sent the
+	 * field), and nothing else identifies it before open_channel. */
+	bool allow_peers_without_networks;
+
 	/* How much to gossip allow a peer every second (bytes) */
 	size_t gossip_stream_limit;
 
diff --git a/connectd/connectd_wire.csv b/connectd/connectd_wire.csv
index c1361a597..15edf557b 100644
--- a/connectd/connectd_wire.csv
+++ b/connectd/connectd_wire.csv
@@ -15,6 +15,7 @@ msgdata,connectd_init,tor_proxyaddr,?wireaddr,
 msgdata,connectd_init,use_tor_proxy_always,bool,
 msgdata,connectd_init,dev_allow_localhost,bool,
 msgdata,connectd_init,use_dns,bool,
+msgdata,connectd_init,allow_peers_without_networks,bool,
 msgdata,connectd_init,tor_password,wirestring,
 msgdata,connectd_init,timeout_secs,u32,
 msgdata,connectd_init,websocket_helper,wirestring,
diff --git a/connectd/peer_exchange_initmsg.c b/connectd/peer_exchange_initmsg.c
index eb7bec648..b0c24c63d 100644
--- a/connectd/peer_exchange_initmsg.c
+++ b/connectd/peer_exchange_initmsg.c
@@ -102,6 +102,21 @@ static struct io_plan *peer_init_received(struct io_conn *conn,
 			msg = cryptomsg_encrypt_msg(NULL, &peer->cs, take(msg));
 			return io_write(conn, msg, tal_count(msg), io_close_cb, NULL);
 		}
+	} else if (!peer->daemon->allow_peers_without_networks
+		   && !bitcoin_blkid_eq(chainparams_block0(chainparams),
+					&chainparams->genesis_blockhash)) {
+		/* This chain shares its genesis with another, so a peer
+		 * that names no chain cannot be told apart from a node of
+		 * the other one, and LND never named any.  See
+		 * doc/blake2b-chain-identity.md. */
+		status_peer_debug(&peer->id,
+				  "Peer names no networks and this chain "
+				  "shares its genesis, closing");
+		msg = towire_warningfmt(NULL, NULL,
+					"No networks named: this chain needs "
+					"one (see allow-peers-without-networks)");
+		msg = cryptomsg_encrypt_msg(NULL, &peer->cs, take(msg));
+		return io_write(conn, msg, tal_count(msg), io_close_cb, NULL);
 	}
 
 	/* fetch optional tlv `remote_addr` */
