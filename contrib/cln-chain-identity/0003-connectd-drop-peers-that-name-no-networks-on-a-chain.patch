diff --git a/connectd/peer_exchange_initmsg.c b/connectd/peer_exchange_initmsg.c
index eb7bec648..b0c24c63d 100644
--- a/connectd/peer_exchange_initmsg.c
+++ b/connectd/peer_exchange_initmsg.c
@@ -102,6 +102,21 @@ static struct io_plan *peer_init_received(struct io_conn *conn,
 			msg = cryptomsg_encrypt_msg(NULL, &peer->cs, take(msg));
 			return io_write(conn, msg, tal_count(msg), io_close_cb, NULL);
 		}
+	} else if (!peer->daemon->allow_peers_without_networks
+		   && !bitcoin_blkid_eq(chainparams_block0(chainparams),
+					&chainparams->genesis_blockhash)) {
+		/* This chain shares its genesis with another, so a peer
+		 * that names no chain cannot be told apart from a node of
+		 * the other one, and LND never named any.  See
+		 * doc/blake2b-chain-identity.md. */
+		status_peer_debug(&peer->id,
+				  "Peer names no networks and this chain "
+				  "shares its genesis, closing");
+		msg = towire_warningfmt(NULL, NULL,
+					"No networks named: this chain needs "
+					"one (see allow-peers-without-networks)");
+		msg = cryptomsg_encrypt_msg(NULL, &peer->cs, take(msg));
+		return io_write(conn, msg, tal_count(msg), io_close_cb, NULL);
 	}
 
 	/* fetch optional tlv `remote_addr` */
