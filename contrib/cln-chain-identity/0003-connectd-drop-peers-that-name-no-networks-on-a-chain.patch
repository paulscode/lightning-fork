diff --git a/lightningd/options.c b/lightningd/options.c
index c611bdd85..bf15d81d2 100644
--- a/lightningd/options.c
+++ b/lightningd/options.c
@@ -1004,6 +1004,7 @@ static const struct config testnet_config = {
 	.rescan = 30,
 
 	.use_dns = true,
+	.allow_peers_without_networks = false,
 
 	/* Excplicitly turns 'on' or 'off' IP discovery feature. */
 	.ip_discovery = OPT_AUTOBOOL_AUTO,
@@ -1082,6 +1083,7 @@ static const struct config mainnet_config = {
 	.rescan = 15,
 
 	.use_dns = true,
+	.allow_peers_without_networks = false,
 
 	/* Excplicitly turns 'on' or 'off' IP discovery feature. */
 	.ip_discovery = OPT_AUTOBOOL_AUTO,
@@ -1600,6 +1602,9 @@ static void register_opts(struct lightningd *ld)
 		       &ld->accept_extra_tlv_types,
 		       "HTLC TLV type to accept (can be used multiple times)");
 
+	opt_register_early_noarg("--allow-peers-without-networks", opt_set_bool,
+				 &ld->config.allow_peers_without_networks,
+				 "Keep peers whose init names no networks; on a chain that shares its genesis with another they are dropped by default");
 	opt_register_early_noarg("--disable-dns", opt_set_invbool, &ld->config.use_dns,
 				 "Disable DNS lookups of peers");
 
