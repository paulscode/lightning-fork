+const struct bitcoin_blkid *chainparams_block0(const struct chainparams *params)
+{
+	static const struct bitcoin_blkid zero;
+
+	if (bitcoin_blkid_eq(&params->block0_hash, &zero))
+		return &params->genesis_blockhash;
+	return &params->block0_hash;
+}
+
+const struct bitcoin_blkid *chainparams_bolt12_implicit_chain(void)
+{
+	/* Bitcoin mainnet's genesis, whatever chain_hash this build carries
+	 * for the network called "bitcoin". */
+	return chainparams_block0(chainparams_for_network("bitcoin"));
+}
+
+bool chainparams_bolt12_implicit(const struct chainparams *params)
+{
+	return bitcoin_blkid_eq(&params->genesis_blockhash,
+				chainparams_bolt12_implicit_chain());
+}
