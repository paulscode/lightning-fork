+ * mainnet, identified by its genesis?  A chain that shares that genesis but
+ * carries another chain_hash is not, and must name itself. */
+bool chainparams_bolt12_implicit(const struct chainparams *params);
+
+/* The chain_hash BOLT 12 implies when none is named: Bitcoin's genesis. */
+const struct bitcoin_blkid *chainparams_bolt12_implicit_chain(void);
