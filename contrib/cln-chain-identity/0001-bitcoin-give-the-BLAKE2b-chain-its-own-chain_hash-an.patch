+/* Pull "ln" + the prefix of any network this build knows, and the prefix a
+ * network had before the chain identity, so that a Bitcoin invoice is still
+ * read as one and refused with the reason. Longest first, so that a prefix
+ * that extends another (blakert over blake, bcrt over bc) is tried first. */
+static bool tok_pull_bolt11_prefix(const char *buffer, jsmntok_t *tok)
+{
+	static const char *names[] = {
+		"regtest", "signet", "testnet4", "testnet", "bitcoin",
+	};
+	for (size_t i = 0; i < ARRAY_SIZE(names); i++) {
+		const struct chainparams *p = chainparams_for_network(names[i]);
+		if (tok_pull(buffer, tok,
+			     tal_fmt(tmpctx, "ln%s", p->lightning_hrp)))
+			return true;
+		if (p->legacy_lightning_hrp
+		    && tok_pull(buffer, tok,
+				tal_fmt(tmpctx, "ln%s", p->legacy_lightning_hrp)))
+			return true;
+	}
+	return false;
+}
