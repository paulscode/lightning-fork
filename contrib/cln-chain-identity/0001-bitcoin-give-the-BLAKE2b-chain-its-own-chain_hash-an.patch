diff --git a/bitcoin/test/run-chainparams-blake2b.c b/bitcoin/test/run-chainparams-blake2b.c
new file mode 100644
index 000000000..f6a078567
--- /dev/null
+++ b/bitcoin/test/run-chainparams-blake2b.c
@@ -0,0 +1,99 @@
+#include "config.h"
+#include <assert.h>
+#include <bitcoin/chainparams.h>
+#include <ccan/array_size/array_size.h>
+#include <ccan/err/err.h>
+#include <ccan/str/hex/hex.h>
+#include <common/setup.h>
+#include <stdio.h>
+
+/* AUTOGENERATED MOCKS START */
+/* AUTOGENERATED MOCKS END */
+
+/* The identity constants of doc/blake2b-chain-identity.md, in the byte
+ * order getblockhash prints, so that a mistake in the little-endian arrays
+ * of chainparams.c shows up here rather than on the wire. */
+static const struct {
+	const char *network;
+	const char *chain_hash;
+	const char *block0;
+	const char *lightning_hrp;
+} expected[] = {
+	{"bitcoin",
+	 "0000000000000050c1e5f69672f459293be14f46e5a494e7a8c8541396f18eeb",
+	 "000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f",
+	 "blake"},
+	{"regtest",
+	 "2594d57b43169a2856ded0623840f0863b9e967b936f6f3d7945da28d909ab1a",
+	 "0f9188f13cb7b2c71f2a335e3a4fc328bf5beb436012afca590b1a11466e2206",
+	 "blakert"},
+	{"signet",
+	 "c283e28a744edd1bf7a47946620de35ae2e8ac84dc0a2b21e29f1ebf36ec6589",
+	 "00000008819873e925422c1ff0f99f7cc9bbb232af63a077a480a3633bee1ef6",
+	 "tbsblake"},
+	{"testnet4",
+	 "572c94664c77fb4ce6a9c4ee50ed8f0eb1bd363061342194ac66fca694aa63a6",
+	 "00000000da84f2bafbbc53dee25a72ae507ff4914b867c565be350b0da8bf043",
+	 "tblake"},
+};
+
+/* A block id as getblockhash prints it: the bytes reversed, in hex. */
+static void check_hex(const char *what, const struct bitcoin_blkid *id,
+		      const char *hex)
+{
+	u8 reversed[sizeof(id->shad.sha.u.u8)];
+	char got[hex_str_size(sizeof(reversed))];
+
+	for (size_t i = 0; i < sizeof(reversed); i++)
+		reversed[i] = id->shad.sha.u.u8[sizeof(reversed) - 1 - i];
+	hex_encode(reversed, sizeof(reversed), got, sizeof(got));
+	if (!streq(got, hex))
+		errx(1, "%s: %s, expected %s", what, got, hex);
+}
+
+int main(int argc, char *argv[])
+{
+	common_setup(argv[0]);
+
+	for (size_t i = 0; i < ARRAY_SIZE(expected); i++) {
+		const struct chainparams *p
+			= chainparams_for_network(expected[i].network);
+
+		assert(p);
+		check_hex(expected[i].network, &p->genesis_blockhash,
+			  expected[i].chain_hash);
+		check_hex(expected[i].network, chainparams_block0(p),
+			  expected[i].block0);
+		assert(streq(p->lightning_hrp, expected[i].lightning_hrp));
+		/* The chain_hash is looked up, block 0 is not. */
+		assert(chainparams_by_chainhash(&p->genesis_blockhash) == p);
+		assert(!chainparams_by_chainhash(chainparams_block0(p)));
+		/* This chain names itself in offers. */
+		assert(!chainparams_bolt12_implicit(p));
+	}
+
+	/* Bitcoin's prefixes belong to no network here: a Bitcoin invoice
+	 * cannot be paid, and an invoice from here cannot be paid there. */
+	assert(!chainparams_by_lightning_hrp("bc"));
+	assert(!chainparams_by_lightning_hrp("bcrt"));
+	assert(!chainparams_by_lightning_hrp("tbs"));
+	assert(chainparams_by_lightning_hrp("blake")
+	       == chainparams_for_network("bitcoin"));
+	assert(chainparams_by_lightning_hrp("blakert")
+	       == chainparams_for_network("regtest"));
+
+	/* BOLT 12's implicit chain is Bitcoin's genesis, not this chain. */
+	check_hex("bolt12 implicit", chainparams_bolt12_implicit_chain(),
+		  "000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f");
+
+	/* A network that keeps its genesis as chain_hash reports it as
+	 * block 0 too. */
+	{
+		const struct chainparams *t = chainparams_for_network("testnet");
+		assert(bitcoin_blkid_eq(chainparams_block0(t),
+					&t->genesis_blockhash));
+	}
+
+	common_shutdown();
+	return 0;
+}
