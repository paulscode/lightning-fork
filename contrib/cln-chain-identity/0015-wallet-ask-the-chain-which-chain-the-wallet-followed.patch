-			 * peers would keep being offered the old. Start the
-			 * store afresh; it is rebuilt from peers. */
-			for (size_t i = 0; i < 2; i++) {
-				const char *store = path_join(
-					tmpctx, w->ld->config_netdir,
-					i == 0 ? GOSSIP_STORE_FILENAME
-					       : GOSSIP_STORE_FILENAME ".corrupt");
-				if (unlink(store) == 0)
-					log_broken(w->log, "Removed %s: its "
-						   "announcements carry the "
-						   "old chain_hash", store);
+			/* The wallet could not say. Asking the operator here
+			 * is a poor second, and it is also the common case
+			 * rather than the rare one: a node that lived through
+			 * the activation is the one least likely to hold the
+			 * activation block. Defer instead, and ask the chain
+			 * once there is a backend to ask, which answers it for
+			 * any wallet holding any block above the fork. See
+			 * wallet_restamp_against_chain(). */
+			if (!followed) {
+				w->restamp_pending = true;
+				w->restamp_was = chainhash;
+				return true;
 			}
+			wallet_restamp(w, &chainhash);
 			chainhash = chainparams->genesis_blockhash;
 		}
 		if (!bitcoin_blkid_eq(&chainhash,
diff --git a/wallet/wallet.h b/wallet/wallet.h
index 504e49aad..2fd0d7d07 100644
--- a/wallet/wallet.h
+++ b/wallet/wallet.h
@@ -56,6 +56,14 @@ struct wallet {
 
 	/* How many keys should we look ahead at most? */
 	u64 keyscan_gap;
+
+	/* Set by wallet_sanity_check when the wallet carries the stamp of a
+	 * chain that shares this one's genesis and its own history cannot say
+	 * which chain it followed. The decision is deferred to
+	 * wallet_restamp_against_chain(), which runs once there is a backend
+	 * to ask. restamp_was is the stamp it carried. */
+	bool restamp_pending;
