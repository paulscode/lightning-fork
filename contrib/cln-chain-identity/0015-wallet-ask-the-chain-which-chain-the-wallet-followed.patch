From b1ac5818a5bc058a25d05f3498ca587fa56b99de Mon Sep 17 00:00:00 2001
From: Paul Lamb <paul@paulscode.com>
Date: Wed, 16 Sep 2026 06:34:48 -0500
Subject: [PATCH 15/15] wallet: ask the chain which chain the wallet followed,
 not the wallet

The wallet-history check asked whether the wallet holds the activation
block, since on mainnet the chain_hash was taken from it. Review against
a real mainnet wallet showed that is the one block such a wallet is
least likely to hold.

A node that lived through the activation stopped where the pre-fork
build could not parse the 164-byte header, and this build resumes from
the highest block it has (blockscan_start in chaintopology.c) rather
than backfilling, so the blocks table has a hole exactly across the
fork. Holes there are ordinary, which is why
wallet_blocks_contig_minheight() exists at all. The reported wallet
holds 20,991 blocks from 504,605 to 972,349 with nothing between 961,628
and 971,901, and the activation block is 961,640.

So the accept path almost never fired for the population it was written
for, and every such node fell through to --restamp-wallet-for-this-chain
and refused to start until the operator passed it. On a distribution
that does not pass it, that is every node rather than only the ambiguous
ones.

Ask the chain instead. wallet_sanity_check runs before there is a
backend, so where the wallet cannot say it now defers, and
settle_deferred_restamp() runs between setup_topology and
begin_topology, where bitcoind is up and no blocks have been scanned
yet. It takes the highest block the wallet holds above the fork, which
is a height where the two chains differ, and asks what this chain has
there. Equal restamps, different refuses, and only a wallet holding no
block above the fork at all still needs the operator to say.

The refuse path keeps its meaning and gains reach: it no longer depends
on the wallet holding one specific block.

Also moves the gossip store removal to log_unusual, which review caught
as the last log_broken left on the success path. fixtures.py:735
collects any line containing **BROKEN** and fixtures.py:590 maps that to
a test error, so a restamp that removed a store failed the run even
though everything worked, and an operator who did exactly as instructed
saw **BROKEN** once per store file. It moves with the rest of the
restamp into wallet_restamp(), which this commit extracts so the
deferred path can call it too.
---
 lightningd/chaintopology.c | 137 ++++++++++++++++++++++++++++++++
 lightningd/chaintopology.h |   5 ++
 lightningd/lightningd.c    |   6 ++
 wallet/wallet.c            | 159 ++++++++++++++++++++++---------------
 wallet/wallet.h            |  25 ++++++
 5 files changed, 269 insertions(+), 63 deletions(-)

diff --git a/lightningd/chaintopology.c b/lightningd/chaintopology.c
index 59cc19922..a9af4216a 100644
--- a/lightningd/chaintopology.c
+++ b/lightningd/chaintopology.c
@@ -1624,6 +1624,143 @@ static void fixup_scan(struct chain_topology *topo)
 				     fixup_scan_block, topo);
 }
 
+/* Where the wallet's own history could not say which chain it followed,
+ * wallet_sanity_check deferred the decision to here. Ask the chain.
+ *
+ * The activation block is the wrong thing to look for in the wallet: a node
+ * that lived through the activation is the one least likely to hold it, since
+ * the pre-fork build stopped at the header it could not parse and this build
+ * resumes from the highest block it has rather than backfilling. Holes in the
+ * blocks table are ordinary, which is what wallet_blocks_contig_minheight()
+ * is for. So take the highest block the wallet does hold above the fork and
+ * ask what this chain has at that height.
+ */
+struct restamp_query {
+	bool done;
+	bool have;
+	struct bitcoin_blkid ours;
+};
+
+static void got_restamp_block(struct bitcoind *bitcoind, u32 height,
+			      struct bitcoin_blkid *blkid,
+			      struct bitcoin_block *blk,
+			      struct restamp_query *q)
+{
+	q->done = true;
+	/* The backend can have no block at that height: it is behind, or it
+	 * is a shorter chain than the wallet saw. Record that, rather than
+	 * leaving ours unset and comparing against whatever was on the
+	 * stack. */
+	/* Derive the id from the block, as new_block() does. Every other
+	 * caller here ignores the blkid parameter, and it arrives in the
+	 * opposite byte order to the one the wallet stores, so comparing
+	 * against it reverses the answer and refuses a wallet that did
+	 * follow this chain. */
+	q->have = (blk != NULL);
+	if (q->have)
+		bitcoin_block_blkid(blk, &q->ours);
+	io_break(bitcoind->ld->topology);
+}
+
+void settle_deferred_restamp(struct chain_topology *topo)
+{
+	struct wallet *w = topo->ld->wallet;
+	struct restamp_query *q;
+	struct bitcoin_blkid theirs, ours;
+	u32 height = 0;
+	bool have_block = false, found;
+	const tal_t *local_ctx;
+	void *ret;
+
+	if (!w->restamp_pending)
+		return;
+	w->restamp_pending = false;
+
+	/* Read the wallet inside a transaction, and let go of it before the
+	 * io_loop below: holding one across that would block every other
+	 * db user for as long as the backend takes to answer. */
+	if (chainparams->chain_hash_block_height != 0) {
+		db_begin_transaction(w->db);
+		have_block = wallet_highest_block_from(
+			w, chainparams->chain_hash_block_height,
+			&height, &theirs);
+		db_commit_transaction(w->db);
+	}
+
+	/* No block above the fork at all, so the chain cannot answer for this
+	 * wallet either and it is back to the operator. A wallet created after
+	 * the activation and never synced is the honest case here. */
+	if (!have_block) {
+		if (!topo->ld->config.restamp_wallet_for_this_chain)
+			fatal("Wallet is stamped with block 0 (%s) and this "
+			      "chain's chain_hash is %s, and it holds no block "
+			      "above height %u for the chain to be asked about, "
+			      "so nothing here can say which chain it followed. "
+			      "Start once with --restamp-wallet-for-this-chain "
+			      "to adopt this chain; there is no way back.",
+			      fmt_bitcoin_blkid(tmpctx, &w->restamp_was),
+			      fmt_bitcoin_blkid(tmpctx,
+						&chainparams->genesis_blockhash),
+			      chainparams->chain_hash_block_height);
+
+		db_begin_transaction(w->db);
+		wallet_restamp(w, &w->restamp_was);
+		db_commit_transaction(w->db);
+		return;
+	}
+
+	/* Not tmpctx: the io_loop below frees it, which would take the request
+	 * and the callback argument with it and leave us waiting for a reply
+	 * that can never arrive. setup_topology() keeps a local context for
+	 * the same reason, and says so. */
+	local_ctx = tal(NULL, char);
+	q = tal(local_ctx, struct restamp_query);
+	q->done = false;
+	q->have = false;
+	memset(&q->ours, 0, sizeof(q->ours));
+	bitcoind_getrawblockbyheight(q, topo->bitcoind, height,
+				     got_restamp_block, q);
+	ret = io_loop_with_timers(topo->ld);
+	assert(ret == topo);
+	if (!q->done) {
+		ret = io_loop_with_timers(topo->ld);
+		assert(ret == topo);
+	}
+	found = q->have;
+	ours = q->ours;
+	tal_free(local_ctx);
+
+	/* Cannot decide without an answer, and guessing either way is worse
+	 * than saying so: adopting could restamp another chain's wallet, and
+	 * refusing could strand a good one behind a backend that is merely
+	 * behind. */
+	if (!found)
+		fatal("Wallet holds block %s at height %u, but this chain's "
+		      "backend has no block at that height, so it cannot say "
+		      "whether this wallet followed this chain. If the backend "
+		      "is still catching up, let it finish and start again.",
+		      fmt_bitcoin_blkid(tmpctx, &theirs), height);
+
+	if (!bitcoin_blkid_eq(&ours, &theirs))
+		fatal("Wallet records block %s at height %u, where this chain "
+		      "has %s, so it followed another chain and is not this "
+		      "chain's wallet. Refusing to restamp it: no flag "
+		      "overrides this, neither --database-upgrade nor "
+		      "--restamp-wallet-for-this-chain. If this is the wrong "
+		      "node for this wallet, point it at the other chain's "
+		      "build.",
+		      fmt_bitcoin_blkid(tmpctx, &theirs), height,
+		      fmt_bitcoin_blkid(tmpctx, &ours));
+
+	log_unusual(topo->log, "Wallet holds block %s at height %u, which is "
+		    "this chain's, so it followed this chain",
+		    fmt_bitcoin_blkid(tmpctx, &theirs), height);
+
+	db_begin_transaction(w->db);
+	wallet_restamp(w, &w->restamp_was);
+	db_commit_transaction(w->db);
+}
+
 void begin_topology(struct chain_topology *topo)
 {
 	/* If we were not synced, start looping to check */
