index 27063f681..e20be7135 100644
--- a/lightningd/lightningd.c
+++ b/lightningd/lightningd.c
@@ -1349,6 +1349,12 @@ int main(int argc, char *argv[])
 	setup_topology(ld->topology);
 	trace_span_end(ld->topology);
 
+	/*~ The wallet may carry the stamp of a chain that shares ours, where
+	 * its own history could not say which one it followed. There is a
+	 * backend now, and no blocks have been scanned yet, so this is the
+	 * place to ask the chain instead. */
+	settle_deferred_restamp(ld->topology);
+
 	db_begin_transaction(ld->wallet->db);
 	trace_span_start("delete_old_htlcs", ld->wallet);
 	wallet_delete_old_htlcs(ld->wallet);
diff --git a/wallet/wallet.c b/wallet/wallet.c
index 74a26e6ac..e7a1feaf3 100644
--- a/wallet/wallet.c
+++ b/wallet/wallet.c
@@ -212,6 +212,9 @@ struct wallet *wallet_new(struct lightningd *ld, struct timers *timers)
 	wallet->ld = ld;
 	wallet->log = new_logger(wallet, ld->log_book, NULL, "wallet");
 	wallet->keyscan_gap = 50;
+	/* tal() does not zero, and a garbage value here sends a healthy
+	 * wallet down the deferred restamp path on the next startup. */
+	wallet->restamp_pending = false;
 	trace_span_start("db_setup", wallet);
 	wallet->db = db_setup(wallet, ld, ld->bip32_base);
 	trace_span_end(wallet);
@@ -4820,6 +4823,86 @@ static bool wallet_followed_this_chain(struct wallet *w, bool *known,
 	return bitcoin_blkid_eq(&blkid, &chainparams->genesis_blockhash);
 }
 
+/* The highest block the wallet holds at or above `minheight`, which is a
+ * block whose id differs between this chain and the one it forked from.
+ *
+ * The activation block itself is the wrong thing to ask for: a node that
+ * lived through the activation is the one least likely to hold it, since the
+ * pre-fork build stopped at the header it could not parse and the fork-aware
+ * build resumes from the highest block it has rather than backfilling (see
+ * blockscan_start in chaintopology.c). Holes are ordinary here, which is why
+ * wallet_blocks_contig_minheight() exists at all. So take whatever the wallet
+ * does have above the fork and ask the chain about that one.
+ */
+bool wallet_highest_block_from(struct wallet *w, u32 minheight,
+			       u32 *height, struct bitcoin_blkid *blkid)
+{
+	struct db_stmt *stmt;
+
+	stmt = db_prepare_v2(w->db,
+			     SQL("SELECT height, hash FROM blocks"
+				 " WHERE height >= ?"
+				 " ORDER BY height DESC LIMIT 1"));
+	db_bind_int(stmt, minheight);
+	db_query_prepared(stmt);
+
+	if (!db_step(stmt)) {
+		tal_free(stmt);
+		return false;
+	}
+
+	*height = db_col_int(stmt, "height");
+	db_col_sha256d(stmt, "hash", &blkid->shad);
+	tal_free(stmt);
+
+	return true;
+}
+
+/* Adopt this chain's chain_hash. A one-way door: the stamp is rewritten, the
+ * announcement signatures peers gave us are cleared (they were over the old
+ * chain_hash, so each channel asks for fresh ones on reestablish and announces
+ * itself again under the new identity), and the gossip store is removed, since
+ * gossipd keeps the first announcement it has for a channel and would
+ * otherwise keep offering peers the old one. The store is rebuilt from peers.
+ */
+void wallet_restamp(struct wallet *w, const struct bitcoin_blkid *was)
+{
+	struct db_stmt *stmt;
+
+	/* Noteworthy, not broken: this is what the operator asked for and it
+	 * worked. log_broken would print **BROKEN**, which alarms anyone
+	 * reading the log and which this project's own test framework treats
+	 * as a failed run. */
+	log_unusual(w->log, "Wallet was stamped with block 0 (%s); adopting "
+		    "this chain's chain_hash %s",
+		    fmt_bitcoin_blkid(tmpctx, was),
+		    fmt_bitcoin_blkid(tmpctx,
+				      &chainparams->genesis_blockhash));
+
+	stmt = db_prepare_v2(w->db,
+			     SQL("UPDATE vars SET blobval = ? "
+				 "WHERE name = 'genesis_hash';"));
+	db_bind_sha256d(stmt, &chainparams->genesis_blockhash.shad);
+	db_exec_prepared_v2(take(stmt));
+
+	stmt = db_prepare_v2(w->db,
+			     SQL("UPDATE channels"
+				 " SET remote_ann_node_sig=?,"
+				 " remote_ann_bitcoin_sig=?"));
+	db_bind_null(stmt);
+	db_bind_null(stmt);
+	db_exec_prepared_v2(take(stmt));
+
+	for (size_t i = 0; i < 2; i++) {
+		const char *store = path_join(tmpctx, w->ld->config_netdir,
+					      i == 0 ? GOSSIP_STORE_FILENAME
+					      : GOSSIP_STORE_FILENAME ".corrupt");
+		if (unlink(store) == 0)
+			log_unusual(w->log, "Removed %s: its announcements "
+				    "carry the old chain_hash", store);
+	}
+}
+
 bool wallet_sanity_check(struct wallet *w)
 {
 	struct bitcoin_blkid chainhash;
@@ -4873,70 +4956,20 @@ bool wallet_sanity_check(struct wallet *w)
 				return false;
 			}
 
