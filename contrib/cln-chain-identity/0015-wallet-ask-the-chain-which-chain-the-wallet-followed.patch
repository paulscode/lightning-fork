 };
 
 static inline enum output_status output_status_in_db(enum output_status s)
@@ -1187,6 +1195,23 @@ void wallet_htlc_sigs_add(struct wallet *w, u64 channel_id,
  */
 bool wallet_sanity_check(struct wallet *w);
 
+/**
+ * wallet_restamp - adopt this chain's chain_hash. A one-way door.
+ *
+ * Rewrites the stamp, clears the announcement signatures peers gave us (they
+ * were over the old chain_hash) and removes the gossip store, which holds the
+ * old announcements. Callers decide whether it is the right thing to do;
+ * this only does it.
+ */
+void wallet_restamp(struct wallet *w, const struct bitcoin_blkid *was);
+
+/**
+ * wallet_highest_block_from - the highest block the wallet holds at or above
+ * a height. False if it holds none.
+ */
+bool wallet_highest_block_from(struct wallet *w, u32 minheight,
+			       u32 *height, struct bitcoin_blkid *blkid);
+
 /**
