From a0919eb1b302b1ed69872e88a42860d6d5e5bbd5 Mon Sep 17 00:00:00 2001
From: Paul Lamb <paul@paulscode.com>
Date: Tue, 15 Sep 2026 14:46:09 -0500
Subject: [PATCH 13/14] tests: canned dbs set at runtime need the flag too

Two tests set database-upgrade on daemon.opts after the node is made
rather than through get_node, so the earlier sweep missed them and
test_scid_upgrade still failed its wallet sanity check.
---
 tests/test_db.py        | 1 +
 tests/test_downgrade.py | 1 +
 2 files changed, 2 insertions(+)

diff --git a/tests/test_db.py b/tests/test_db.py
index a36095efc..3815ec181 100644
--- a/tests/test_db.py
+++ b/tests/test_db.py
@@ -160,6 +160,7 @@ def test_scid_upgrade(node_factory, bitcoind):
     assert l1.daemon.is_in_stderr(r'Refusing to upgrade db from version [0-9]* to [0-9]* \(database-upgrade=false\)')
 
     l1.daemon.opts['database-upgrade'] = True
+    l1.daemon.opts['restamp-wallet-for-this-chain'] = None
     l1.daemon.start()
     assert l1.db_query('SELECT scid FROM channels;') == [{'scid': scid_to_int('103x1x1')}]
     assert l1.db_query('SELECT failscid FROM payments;') == [{'failscid': scid_to_int('103x1x1')}]
diff --git a/tests/test_downgrade.py b/tests/test_downgrade.py
index c63726ac1..aaebeda2d 100644
--- a/tests/test_downgrade.py
+++ b/tests/test_downgrade.py
@@ -92,6 +92,7 @@ def test_downgrade(node_factory, executor):
 
     # Should be able to upgrade without any trouble
     l1.daemon.opts['database-upgrade'] = True
+    l1.daemon.opts['restamp-wallet-for-this-chain'] = None
     l1.start()
     # Note: currently a noop, this will break on first database upgrade.
     assert not l1.daemon.is_in_log("Updating database from version 281")
