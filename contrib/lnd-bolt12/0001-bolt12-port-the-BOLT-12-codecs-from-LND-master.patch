+			// InvreqChain == bitcoin (valid).
+			ir.InvreqChain = tlv.SomeRecordT(
+				tlv.NewPrimitiveRecord[tlv.TlvType80](
+					bitcoinMainnetGenesisHash,
+				),
+			)
+			require.NoError(t, ValidateInvoiceRequestWrite(ir))
