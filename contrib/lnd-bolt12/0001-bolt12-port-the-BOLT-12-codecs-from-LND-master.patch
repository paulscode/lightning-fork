+		// mismatched chain is rejected regardless of the signature.
+		err := ValidateInvoiceRequestRead(
+			ir, bitcoinMainnetGenesisHash, nil,
+		)
+		require.ErrorIs(t, err, ErrUnsupportedChain)
+	})
+}
