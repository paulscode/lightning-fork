+	t.Run("present-but-nil node_id", func(t *testing.T) {
+		t.Parallel()
+
+		inv := validInvoice(t)
+		inv.InvoiceNodeID = tlv.SomeRecordT(
+			tlv.NewPrimitiveRecord[tlv.TlvType176](
