+
+    // The amount paid in millisatoshi, once settled.
+    uint64 amount_paid_msat = 9;
+}
+
+message ListOfferInvoicesRequest {
+    // List only the invoices for this offer, when set.
+    bytes offer_id = 1;
+}
+
+message ListOfferInvoicesResponse {
+    repeated OfferInvoice invoices = 1;
+}
