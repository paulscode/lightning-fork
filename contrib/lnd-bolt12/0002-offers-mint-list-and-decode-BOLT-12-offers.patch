+	env.manager, err = NewManager(Config{
+		ChainHash: testChain,
+		Secret:    secret,
+		IssuerKey: keychain.KeyDescriptor{
+			KeyLocator: keychain.KeyLocator{
+				Family: keychain.KeyFamilyNodeKey,
