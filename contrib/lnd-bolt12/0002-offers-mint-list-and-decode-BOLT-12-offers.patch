+}
+
+type fakePathBuilder struct {
+	calls   int
+	secrets [][32]byte
+	paths   []lnwire.BlindedPath
+	err     error
+}
+
+func (f *fakePathBuilder) BuildOfferPaths(_ context.Context,
+	secret [32]byte) ([]lnwire.BlindedPath, error) {
+
+	f.calls++
+	f.secrets = append(f.secrets, secret)
+
+	return f.paths, f.err
+}
