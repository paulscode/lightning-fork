+func newTestEnvWithSecret(t *testing.T, secret [32]byte) *testEnv {
+	t.Helper()
+
+	issuer, err := btcec.NewPrivateKey()
+	require.NoError(t, err)
+	env := &testEnv{
+		store:  testStore(t),
+		clock:  clock.NewTestClock(time.Unix(1_800_000_000, 0)),
+		issuer: issuer,
+		paths:  &fakePathBuilder{},
+		reach:  true,
